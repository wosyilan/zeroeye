root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python
[*.py]
indent_size = 4
max_line_length = 88

# Rust
[*.rs]
indent_size = 4
max_line_length = 100

# Markdown
[*.{md,mkd,mdwn,mdown,markdown}]
trim_trailing_whitespace = false
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# Makefile
[Makefile,makefile,GNUmakefile]
indent_style = tab

# Shell scripts
[*.{sh,bash,zsh}]
indent_size = 2

# Docker
[Dockerfile]
indent_size = 4

# Git files
[.gitattributes,.gitignore,.gitmodules]
indent_size = 2

# TOML (Rust/Cargo)
[*.toml]
indent_size = 2
