root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab

[*.{ts,tsx,js,jsx,json,css,scss,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.c]
indent_style = tab

[*.java]
indent_style = space
indent_size = 4

[*.rb]
indent_style = space
indent_size = 2

[*.pl]
indent_style = space
indent_size = 4

[*.sh]
indent_style = tab

[Makefile]
indent_style = tab

[{*.md,*.markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
